<configuration>
	<system.webServer>
	  <staticContent>
		<mimeMap fileExtension=".data.unityweb" mimeType="application/octet-stream" />
		<mimeMap fileExtension=".wasm.unityweb" mimeType="application/wasm" />
		<mimeMap fileExtension=".framework.js.unityweb" mimeType="application/javascript" />
	  </staticContent>
	  <urlCompression doStaticCompression="false" doDynamicCompression="false" />
	</system.webServer>
</configuration>
